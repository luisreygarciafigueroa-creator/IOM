io:hasAxisPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain io:VectorStep ;
    rdfs:range xsd:integer .

io:hasCyclePhase a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain io:VectorStep ;
    rdfs:range xsd:string .

io:hasDirection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range io:Direction .

io:hasLevel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain io:ExpandedCategory ;
    rdfs:range xsd:integer .

io:hasLocalPos a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range xsd:integer .

io:hasPerspective a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range io:Perspective .

io:hasPhase a owl:DatatypeProperty,
        owl:FunctionalProperty ;
