@prefix io: <http://example.org/iom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

io:Ontology a owl:Ontology ;
    rdfs:label "Ontología IOM"@es ;
    rdfs:comment "Operacionalización canónica del marco I.O. con cinco perspectivas. Orden de presentación 1.9.0: orientación|cuántico|dirección … animal|humano|IA. El índice es ordinal, no identidad."@es ;
    owl:versionInfo "1.9.0" .
