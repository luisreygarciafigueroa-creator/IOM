@prefix io: <http://example.org/iom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

io:Ontology a owl:Ontology ;
    rdfs:label "Ontología IOM"@es ;
    rdfs:comment "Transcripción de las tablas de Fase de Avance, Fase de Retroceso y vectores cuarta y quinta aportadas por el usuario. No son datos empíricos."@es ;
    owl:versionInfo "1.1.0" .

io:creates a owl:ObjectProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range io:OntoNode .

io:declaredExpandedCategoryCount a owl:DatatypeProperty ;
    rdfs:domain io:SourceModel ;
    rdfs:range xsd:integer .

io:declaredOperatorCount a owl:DatatypeProperty ;
    rdfs:domain io:SourceModel ;
    rdfs:range xsd:integer .

io:declaredPerspectiveCount a owl:DatatypeProperty ;
    rdfs:domain io:SourceModel ;
    rdfs:range xsd:integer .

io:declaredTriadCount a owl:DatatypeProperty ;
    rdfs:domain io:SourceModel ;
    rdfs:range xsd:integer .

io:displayArrow a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain io:VectorStep ;
    rdfs:range xsd:string .

io:expanded_L0_01 a io:ExpandedCategory ;
    rdfs:label "Vacío Generativo (V)"@es ;
