    rdfs:range xsd:string .

io:hasPosition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range io:Position .

io:hasStepIndex a owl:DatatypeProperty,
        owl:FunctionalProperty ;
