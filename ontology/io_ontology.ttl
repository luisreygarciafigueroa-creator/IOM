    rdfs:range xsd:integer .

io:hasTriadIndex a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range xsd:integer .

io:hasVector a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain io:VectorStep ;
    rdfs:range io:Perspective .

io:mirrorOf a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain io:OntoNode ;
    rdfs:range io:OntoNode .

