@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix io: <http://example.org/iom#> .

io:StructuralShape a sh:NodeShape ;
    sh:targetClass io:OntoNode ;
    sh:property [
        sh:path io:hasTriadIndex ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 12 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path io:hasPhase ;
        sh:in ( "adv" "ret" ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path io:hasLocalPos ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path io:hasDirection ;
        sh:in ( io:evol io:invol ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path io:mirrorOf ;
        sh:class io:OntoNode ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "mirrorOf debe enlazar recíprocamente un nodo de la misma tríada y posición local, en la fase opuesta (adv/ret)." ;
        sh:select """
            PREFIX io: <http://example.org/iom#>
            SELECT $this
            WHERE {
                $this io:hasTriadIndex ?triad ;
                      io:hasLocalPos ?pos ;
                      io:hasPhase ?phase ;
                      io:mirrorOf ?mirror .
                FILTER NOT EXISTS {
                    ?mirror a io:OntoNode ;
                            io:hasTriadIndex ?triad ;
                            io:hasLocalPos ?pos ;
                            io:hasPhase ?mirrorPhase ;
                            io:mirrorOf $this .
                    FILTER ((?phase = "adv" && ?mirrorPhase = "ret") ||
                            (?phase = "ret" && ?mirrorPhase = "adv"))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "La dirección debe corresponder a la fase: avance=evol y retroceso=invol." ;
        sh:select """
            PREFIX io: <http://example.org/iom#>
            SELECT $this
            WHERE {
                $this io:hasPhase ?phase ; io:hasDirection ?direction .
                FILTER ((?phase = "adv" && ?direction != io:evol) ||
                        (?phase = "ret" && ?direction != io:invol))
            }
        """
    ] .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

io:ExpandedCategoryShape a sh:NodeShape ;
    sh:targetClass io:ExpandedCategory ;
    sh:property [
        sh:path io:hasLevel ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 4 ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:languageIn ( "es" ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

io:SourceTriadExampleShape a sh:NodeShape ;
    sh:targetClass io:SourceTriadExample ;
    sh:property [
        sh:path rdfs:label ;
        sh:languageIn ( "es" ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

io:SourceModelShape a sh:NodeShape ;
    sh:targetNode io:SourceModel ;
    sh:property [ sh:path io:declaredTriadCount ; sh:hasValue 13 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path io:declaredPerspectiveCount ; sh:hasValue 5 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path io:declaredOperatorCount ; sh:hasValue 4 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path io:declaredExpandedCategoryCount ; sh:hasValue 21 ; sh:minCount 1 ; sh:maxCount 1 ] .
